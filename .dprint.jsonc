{
  "lineWidth": 80,
  "useTabs": false,
  "indentWidth": 2,
  "markdown": {
    "textWrap": "maintain"
  },
  "includes": [
    "**/*.md"
  ],
  "excludes": [
    "**/node_modules/**",
    "**/dist/**",
    ".git/**",
    ".agent-notes/**",
    ".agent-worktrees/**",
    "tasks/**"
  ],
  // Update with: `dprint config update`.
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.21.1.wasm"
  ]
}
