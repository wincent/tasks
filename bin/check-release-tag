#!/usr/bin/env bash
set -euo pipefail

fail() { printf '%s\n' "$*" >&2; exit 1; }

[[ "$GITHUB_SERVER_URL" == https://github.com && "$GITHUB_REPOSITORY" == "${RELEASE_REPOSITORY:?Set RELEASE_REPOSITORY in the release environment}" ]] || fail 'Not the configured release repository'
[[ "$GITHUB_EVENT_NAME" == push && "$GITHUB_REF" =~ ^refs/tags/v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] || fail 'Expected a version tag push (vMAJOR.MINOR.PATCH)'
tag=${GITHUB_REF#refs/tags/}
after=$(jq -er --arg ref "$GITHUB_REF" '
  select(.created == true and .deleted == false and .ref == $ref) | .after
' "$GITHUB_EVENT_PATH") || fail 'Expected creation of the release tag'

# Read the exact ref, not a prefix match or the peeled commit returned by the
# releases API. Use the same repository as the workflow and its token.
repo="repos/$GITHUB_REPOSITORY"
tag_object=$(gh api "$repo/git/ref/tags/$tag" --jq '.object | select(.type == "tag") | .sha')
[[ "$tag_object" =~ ^[0-9a-f]{40}$ ]] || fail 'Expected an annotated release tag'
[[ "$(git rev-parse --verify "$GITHUB_REF^{tag}")" == "$tag_object" ]] || fail 'The checked-out tag differs from the current remote tag'

# Trust only the SSH allowlist supplied outside this checkout. Disable the other
# signature backends so an unrelated system keyring cannot authorize a tag.
umask 077
signers=$(mktemp)
trap 'rm -f "$signers"' EXIT
printf '%s\n' "${RELEASE_ALLOWED_SIGNERS:?Set RELEASE_ALLOWED_SIGNERS in the release environment}" > "$signers"
git -c gpg.ssh.allowedSignersFile="$signers" -c gpg.minTrustLevel=fully \
  -c gpg.openpgp.program=false -c gpg.x509.program=false verify-tag "$tag_object" || fail 'The tag was not signed by an approved release key'
[[ "$(git cat-file tag "$tag_object" | awk 'NR == 3 {print}')" == "tag $tag" ]] || fail 'The signed tag name differs from the pushed ref'

commit=$(git rev-parse --verify "$tag_object^{commit}")
[[ "$commit" == "$GITHUB_SHA" && "$commit" == "$(git rev-parse HEAD)" ]] || fail 'The tag does not point to the event source commit'
# The push payload may report the raw ref target or the peeled commit.
[[ "$after" == "$tag_object" || "$after" == "$commit" ]] || fail 'The tag does not match the push event'

main=$(gh api "$repo/git/ref/heads/main" --jq '.object | select(.type == "commit") | .sha')
[[ "$main" =~ ^[0-9a-f]{40}$ ]] || fail 'Could not identify the current main tip'
# Compare on GitHub so main can advance between checkout and verification
# without leaving the runner unable to resolve the new tip locally.
base=$(gh api "$repo/compare/$commit...$main?per_page=1" --jq '.merge_base_commit.sha')
[[ "$base" == "$commit" ]] || fail 'The release commit must be reachable from the current main tip'

if ! gh api --method GET --paginate "$repo/actions/workflows/ci.yml/runs" \
  -f branch=main -f event=push -f status=success -f head_sha="$commit" -F per_page=100 |
  jq -es --arg sha "$commit" --arg id "$GITHUB_REPOSITORY_ID" '
    any(.[].workflow_runs[];
      .head_sha == $sha and .head_branch == "main" and .event == "push" and
      .status == "completed" and .conclusion == "success" and
      (.head_repository.id | tostring) == $id)
  ' >/dev/null; then
  fail 'The release commit needs a successful CI run from a push to main in this repository'
fi

printf 'commit=%s\ntag_object=%s\n' "$commit" "$tag_object" >> "$GITHUB_OUTPUT"
