#!/usr/bin/env bash
set -euo pipefail

fail() { printf '%s\n' "$*" >&2; exit 1; }

[[ $# == 4 ]] || fail "Usage: $0 <commit> <tag> <target> <output>"
commit=$1
tag=$2
target=$3
output=$4
[[ "$tag" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] || fail 'Expected a release tag (vMAJOR.MINOR.PATCH)'
[[ "$(git rev-parse HEAD)" == "$commit" && -z "$(git status --porcelain --untracked-files=all)" ]] || fail 'Expected a clean checkout of the verified release commit'

export CGO_ENABLED=1 GOTOOLCHAIN=local
[[ "$(go env GOOS)-$(go env GOARCH)" == "$target" ]] || fail "This runner cannot build $target natively"
libgit2=$(pkg-config --modversion libgit2)
[[ "$libgit2" == 1.9.* ]] || fail "Expected libgit2 1.9.x; found $libgit2"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p "$output"
go mod download
go mod verify
modules=$(go list -mod=readonly -deps -f '{{if and .Module (not .Module.Main)}}{{.Module.Path}} {{.Module.Version}}{{end}}' ./cmd/tasks)
[[ $(printf '%s\n' "$modules" | awk 'NF' | LC_ALL=C sort -u) == 'github.com/rivo/uniseg v0.4.7' ]] ||
  fail 'Review third-party notices for the linked Go modules'
uniseg=$(go list -mod=readonly -m -f '{{.Dir}}' github.com/rivo/uniseg)
goroot=$(go env GOROOT)
go_license="$goroot/LICENSE"
# Homebrew installs LICENSE at the versioned formula root.
if [[ ! -s "$go_license" && $(basename "$goroot") == libexec ]]; then
  go_license="$goroot/../LICENSE"
fi
for notice in "$uniseg/LICENSE.txt" "$go_license" "$goroot/PATENTS" \
  licenses/Go-math-notices.txt licenses/Unicode-DFS-2016.txt licenses/Unicode-3.0.txt; do
  [[ -s "$notice" ]] || fail "Missing release notice: $notice"
done
{
  printf '%s\n\n' 'Third-party notices for code and data included in tasks.'
  printf '%s\n\n' 'github.com/rivo/uniseg v0.4.7 (MIT)'
  cat "$uniseg/LICENSE.txt"
  printf '\nGo runtime and standard library (%s)\n\n' "$(go env GOVERSION)"
  cat "$go_license"
  printf '\nGo patent grant\n\n'
  cat "$goroot/PATENTS"
  printf '\n'
  cat licenses/Go-math-notices.txt
  printf '\nUnicode Character Database and Emoji data used by uniseg and Go\n'
  printf 'Unicode 15.0.0 data: Copyright © 2022 Unicode, Inc.\n\n'
  cat licenses/Unicode-DFS-2016.txt
  printf '\n'
  cat licenses/Unicode-3.0.txt
  printf '\n%s\n' 'External runtime dependency (not included): shared libgit2 1.9.x.'
  printf '%s\n' 'libgit2: GPL-2.0-only with linking exception; see https://github.com/libgit2/libgit2/blob/main/COPYING.'
} > "$work/THIRD-PARTY-NOTICES.txt"
go build -mod=readonly -trimpath \
  -ldflags "-X github.com/wincent/tasks/internal/cli.releaseVersion=$tag" \
  -o "$work/tasks" ./cmd/tasks
{
  printf 'Commit: %s\nTarget: %s\nlibgit2 (pkg-config): %s\n' "$commit" "$target" "$libgit2"
  go version
  "$(go env CC)" --version
  pkg-config --version | awk '{print "pkg-config: " $0}'
  go version -m "$work/tasks"
  case "$target" in
    linux-*)
      dpkg-query -W gcc libc6 libgit2-1.9
      ldd "$work/tasks"
      ;;
    darwin-*)
      sw_vers
      otool -L "$work/tasks"
      ;;
    *) fail "Unsupported release target: $target" ;;
  esac
} > "$work/BUILD-INFO.txt"
cp UNLICENSE.md "$work/"
archive="$work/tasks-$target.tar.gz"
COPYFILE_DISABLE=1 tar -C "$work" -czf "$archive" tasks BUILD-INFO.txt UNLICENSE.md THIRD-PARTY-NOTICES.txt

mkdir "$work/smoke"
tar -C "$work/smoke" -xzf "$archive"
cmp "$work/THIRD-PARTY-NOTICES.txt" "$work/smoke/THIRD-PARTY-NOTICES.txt"
cmp UNLICENSE.md "$work/smoke/UNLICENSE.md"
"$work/smoke/tasks" --help >/dev/null
printf '%s\n' "$tag" > "$work/expected-version"
for arg in version --version; do
  "$work/smoke/tasks" "$arg" > "$work/actual-version"
  diff -u "$work/expected-version" "$work/actual-version" || fail "Expected tasks $arg to report $tag"
done
mv "$archive" "$output/"
